{
	"name": "shlips",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"start": "node build",
		"build:pkg": "npm run package --workspace=odh-autocoder",
		"dev:pkg": "npm run package:watch --workspace=odh-autocoder",
		"test:pkg": "npm run test --workspace=odh-autocoder",
		"lint:pkg": "npm run lint --workspace=odh-autocoder",
		"dev:odh": "npm run build:pkg && npm run dev --workspace=odh-app",
		"build:odh": "npm run build:pkg && npm run build --workspace=odh-app",
		"test:odh": "npm run test --workspace=odh-app",
		"test:all": "npm test && npm run test:pkg && npm run test:odh",
		"predev": "npm run build:pkg",
		"dev": "vite dev",
		"prebuild": "npm run build:pkg",
		"build": "vite build",
		"preview": "vite preview",
		"precheck": "npm run build:pkg",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin-search-dir . --check .",
		"format": "prettier --plugin-search-dir . --write .",
		"pretest": "npm run build:pkg",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.48.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/fhir": "^0.0.41",
		"@types/node": "^24.2.0",
		"@types/pako": "^2.0.0",
		"@types/qrcode": "^1.5.0",
		"jsdom": "^24.0.0",
		"prettier": "^2.8.0",
		"prettier-plugin-svelte": "^2.8.1",
		"sass": "^1.97.3",
		"svelte-check": "^3.0.1",
		"tslib": "^2.4.1",
		"typescript": "^4.9.3",
		"vitest": "^0.34.6"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"@sveltejs/adapter-node": "^1.3.1",
		"@sveltejs/kit": "^1.30.3",
		"@sveltestrap/sveltestrap": "^6.2.8",
		"base64url": "^3.0.1",
		"bootstrap": "^5.3.8",
		"buffer": "^6.0.3",
		"dotenv": "^16.4.7",
		"fhirclient": "^2.5.2",
		"jose": "^4.11.4",
		"oidc-client-ts": "^3.1.0",
		"pako": "^2.1.0",
		"pdf-lib": "^1.17.1",
		"qrcode": "^1.5.1",
		"serve": "^14.2.0",
		"svelte": "^4.2.20",
		"text-to-image": "^8.0.1",
		"vite": "^4.5.14"
	}
}
