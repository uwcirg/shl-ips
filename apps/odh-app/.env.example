# Copy to .env and fill in. Never commit .env.

# Required. Subscription key for the NIOSH Industry and Occupation autocoder API. Server-only:
# it is read at runtime through $env/dynamic/private and never sent to the browser.
AUTOCODER_API_KEY=

# Optional. Autocoder endpoint; defaults to the staging instance
# (https://apistg.cdc.gov/nioautocoder/1.1.0/code).
AUTOCODER_API_URL=

# Production (node build) behind a proxy: the public origin of the app, e.g.
# https://odh.example.org, so SvelteKit knows its own URL.
# ORIGIN=
