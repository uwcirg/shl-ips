{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"moduleDetection": "force",
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"moduleResolution": "node",
		"module": "ESNext",
		"noEmit": true,
		"lib": ["es2022", "dom"],
		"sourceMap": true,
		"ignoreDeprecations": "5.0"
	}
}
