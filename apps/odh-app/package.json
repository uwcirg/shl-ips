{
	"name": "odh-app",
	"version": "0.1.0",
	"private": true,
	"description": "Standalone occupational data for health (ODH) form: code work history with the NIOSH autocoder and download it as FHIR",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@sveltejs/kit": "^1.30.3",
		"@sveltestrap/sveltestrap": "^6.2.8",
		"bootstrap": "^5.3.8",
		"odh-autocoder": "^0.1.0",
		"svelte": "^4.2.20"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^1.3.1",
		"@types/fhir": "^0.0.41",
		"svelte-check": "^3.0.1",
		"tslib": "^2.4.1",
		"typescript": "^4.9.3",
		"vite": "^4.5.14",
		"vitest": "^0.34.6"
	}
}
