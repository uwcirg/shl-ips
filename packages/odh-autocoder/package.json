{
	"name": "odh-autocoder",
	"version": "0.1.0",
	"private": true,
	"description": "Occupational Data for Health (ODH) form with NIOSH autocoder lookup, and builders for the resulting FHIR resources",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"package": "svelte-kit sync && svelte-package && publint",
		"package:watch": "svelte-kit sync && svelte-package --watch",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		}
	},
	"typesVersions": {
		">4.0": {
			"index.d.ts": [
				"./dist/index.d.ts"
			],
			"server": [
				"./dist/server/index.d.ts"
			]
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^1.30.3",
		"@sveltestrap/sveltestrap": "^6.2.8",
		"svelte": "^4.2.20"
	},
	"dependencies": {
		"@types/fhir": "^0.0.41",
		"esm-env": "^1.2.2"
	},
	"devDependencies": {
		"@sveltejs/kit": "^1.30.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltestrap/sveltestrap": "^6.2.8",
		"@testing-library/jest-dom": "^7.0.1",
		"bootstrap": "^5.3.8",
		"@testing-library/svelte": "^5.4.2",
		"@typescript-eslint/parser": "^6.21.0",
		"eslint": "^8.57.1",
		"jsdom": "^24.0.0",
		"publint": "^0.2.12",
		"svelte": "^4.2.20",
		"svelte-check": "^3.0.1",
		"svelte-eslint-parser": "^0.43.0",
		"tslib": "^2.4.1",
		"typescript": "^4.9.3",
		"vite": "^4.5.14",
		"vitest": "^0.34.6"
	}
}
